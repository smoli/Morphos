{
  "name": "morphos",
  "version": "0.1.0",
  "description": "Eine selbst-entwickelnde Electron-App: Der Anwender beschreibt, was die App sein soll, und ein LLM erschafft und verändert die Oberfläche live.",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "start": "electron .",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "vue-tsc --noEmit"
  },
  "keywords": [
    "electron",
    "vue",
    "pinia",
    "typescript",
    "llm",
    "claude",
    "self-evolving",
    "generative-ui"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "htm": "^3.1.1",
    "pinia": "^2.2.4",
    "preact": "^10.29.8",
    "vue": "^3.5.12",
    "vue-router": "^4.4.5"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "@vitejs/plugin-vue": "^5.1.4",
    "@vue/test-utils": "^2.4.6",
    "electron": "^33.0.0",
    "jsdom": "^25.0.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.9",
    "vite-plugin-electron": "^0.28.8",
    "vite-plugin-electron-renderer": "^0.14.6",
    "vitest": "^2.1.3",
    "vue-tsc": "^2.1.6"
  },
  "allowScripts": {
    "electron@33.4.11": true
  }
}
